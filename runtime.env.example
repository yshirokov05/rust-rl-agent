# Copy the values you need into the PowerShell session that launches the
# server. start_pipeline.bat preserves caller overrides and supplies the same
# safe defaults for omitted values.
RUST_RL_SHARED_DATA=C:\Projects\rust-rl-agent\shared-data
RUST_RL_BOT_COUNT=1
RUST_RL_NUM_ENVS=1
RUST_RL_INVULNERABLE=true
RUST_RL_OBSERVATION_TIMEOUT=10
RUST_RL_TOTAL_TIMESTEPS=10000
RUST_RL_DEVICE=cpu
RUST_RL_START_TENSORBOARD=true
RUST_RL_TENSORBOARD_PORT=6006
RUST_RL_BRIDGE_SMOKE_TIMEOUT=180
RUST_RL_GATHER_SMOKE_TIMEOUT=180
RUST_RL_SERVER_SEED=11111
RUST_RL_SERVER_WORLDSIZE=3000
RUST_RL_CHECKPOINT_DIR=C:\Projects\rust-rl-agent\models\mvp_checkpoints
RUST_RL_PYTHON_EXE=C:\Projects\rust-rl-agent\venv\Scripts\python.exe
RUST_DEDICATED_EXE=C:\Projects\rust-rl-agent\server\server\steamapps\common\rust_dedicated\RustDedicated.exe
RUST_RL_BUNDLE_PATH=C:\Projects\rust-rl-agent\server\server\steamapps\common\rust_dedicated\RustDedicated_Data\Bundles
